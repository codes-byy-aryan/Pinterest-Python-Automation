# ─── Gemini (Google AI Studio) ────────────────────────────────────────────────
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Meta Developer Console → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=your_whatsapp_permanent_token_here
WHATSAPP_PHONE_ID=your_phone_number_id_here
# Recipient number in international format WITHOUT + (e.g. 919876543210 for India)
WHATSAPP_TO_NUMBER=91XXXXXXXXXX

# ─── Pinterest API (OPTIONAL) ──────────────────────────────────────────────────
# If left blank, the script uses curated seed keywords (still great!)
# Get token at: https://developers.pinterest.com/
PINTEREST_ACCESS_TOKEN=
